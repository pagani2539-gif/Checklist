# ค่าเริ่มต้นที่จะแสดงในช่อง Base URL ตอนสร้างสถานี
VITE_VEHICLE_SEARCH_BASE_URL=
# ค่าเริ่มต้นของ Port เมื่อผู้ใช้กรอกเฉพาะ IP/Host
VITE_VEHICLE_SEARCH_DEFAULT_PORT=3005
# ถ้ามี Proxy กลาง ให้กำหนด Base URL ของ Proxy ได้ เช่น http://proxy-host:port
VITE_VEHICLE_SEARCH_PROXY_BASE_URL=

# ใช้เฉพาะเป็นปลายทางสำรองของ proxy เมื่อ API ไม่เปิด CORS
# ไม่จำเป็นต้องเพิ่ม IP ของสถานีใหม่ หาก API สถานีนั้นเปิด CORS
VEHICLE_SEARCH_ALLOWED_ORIGINS=
# Browser connect allowlist for external Vehicle API proxies; comma-separated origins only.
VEHICLE_SEARCH_PROXY_ALLOWED_ORIGINS=

# ใช้เป็นค่าเริ่มต้นสำรองของ server เท่านั้น เมื่อไม่ได้กรอก URL ในสถานี
VEHICLE_SEARCH_DEFAULT_BASE_URL=
VEHICLE_SEARCH_ENFORCE_STATION_TARGET=true
# JSON map: Station Profile id -> approved Vehicle API base URL. Keep this server-side.
VEHICLE_SEARCH_STATION_TARGETS={}

# Central persistence. Use VITE_STORAGE_MODE=server only behind the API server.
VITE_STORAGE_MODE=server
# Dev-server proxy target for /api/v1 when the browser is served by Vite.
VITE_SERVER_API_TARGET=http://127.0.0.1:4173
VITE_VEHICLE_PROXY_ENFORCE_STATION_TARGET=true
# Set CHECKLIST_STORAGE_BACKEND=postgres for the public multi-station deployment.
CHECKLIST_STORAGE_BACKEND=postgres
CHECKLIST_DATABASE_URL=postgres://checklist:change-me@127.0.0.1:5432/checklist
CHECKLIST_PG_POOL_MAX=10
CHECKLIST_PG_SSL=false
# Filesystem attachments for local/pilot. Relative paths are anchored at the project root.
CHECKLIST_ATTACHMENT_BACKEND=filesystem
CHECKLIST_ATTACHMENTS_DIR=./data/attachments
# Optional MinIO/S3-compatible settings, used only with CHECKLIST_ATTACHMENT_BACKEND=s3.
# CHECKLIST_S3_ENDPOINT=http://127.0.0.1:9000
# CHECKLIST_S3_REGION=us-east-1
# CHECKLIST_S3_BUCKET=checklist-attachments
# CHECKLIST_S3_ACCESS_KEY=change-me
# CHECKLIST_S3_SECRET_KEY=change-me
# CHECKLIST_S3_FORCE_PATH_STYLE=true
CHECKLIST_DIST_DIR=./dist
# Production/public default: accounts are provisioned by the highest admin in PostgreSQL.
CHECKLIST_AUTH_MODE=local
CHECKLIST_COOKIE_SECURE=true
CHECKLIST_SESSION_SECONDS=28800
CHECKLIST_ENFORCE_STATION_SCOPE=true
REQUIRE_VEHICLE_API_READY=true
